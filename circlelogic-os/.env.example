# LOCAL DEVELOPMENT ONLY. Copy this file to .env.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8000
ALLOW_SIGNUP=false
# Leave blank locally to generate a key in data/.vault-key.
# Production MUST supply a persistent Fernet key via approved secret management.
VAULT_KEY=
PROVISION_TOKEN=
# DATA_DIR defaults to the project's data directory when using run.py.
# DATA_DIR=/absolute/path/to/persistent-data

# Set false after creating your own private local workspace to skip default-account bootstrap.
BOOTSTRAP_TESTING_ACCOUNT=true
